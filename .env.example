# Load variables explicitly into the process; never commit real credentials.
DATABASE_URL=mysql+pymysql://logsense_app:REPLACE_ME@127.0.0.1:13306/logsense_dev
TEST_DATABASE_URL=mysql+pymysql://logsense_app:REPLACE_ME@127.0.0.1:13306/logsense_test_UNIQUE
FLASK_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
# Local HTTP only; use 1 behind a correctly configured HTTPS deployment.
COOKIE_SECURE=0
# Optional local read-only operator API; login + UserDataset grants are preferred.
DATABASE_READ_TOKEN=
DATABASE_ALLOWED_DATASETS=
# SMTP is opt-in, STARTTLS is mandatory, and sending runs outside HTTP requests.
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.invalid
SMTP_TO=analyst@example.invalid
