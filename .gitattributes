# Installer line endings are part of the product: cmd.exe needs CRLF, POSIX shells need LF.
*.sh text eol=lf
*.command text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
packaging/windows/** text eol=crlf
packaging/posix/** text eol=lf
# Python sources are LF everywhere (ruff format enforces it too).
*.py text eol=lf
